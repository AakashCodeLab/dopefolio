{
  "name": "dopefolio",
  "version": "1.0.0",
  "description": "Personal portfolio website showcasing frontend web development skills",
  "main": "index.js",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "watch-sass": "sass --watch sass/main.scss:css/style.css",
    "compile-sass": "sass sass/main.scss css/style.comp.css",
    "concat-css": "concat -o css/style.concat.css css/style.css css/style.comp.css",
    "prefix-css": "postcss --use autoprefixer -b 'last 5 versions' css/style.concat.css -o css/style.prefix.css",
    "compress-css": "sass sass/main.scss css/style.css --style=compressed",
    "build-css": "npm-run-all compile-sass concat-css prefix-css compress-css",
    "dev": "npm run watch-sass"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "author": "Aakash Singh",
  "license": "GPL-3.0",
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "concat": "^1.0.3",
    "sass": "^1.85.0",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^10.1.0"
  }
}
